# Example environment for Tulzo. Copy to .env.local and fill in. Never commit real values.
# (Only the email-notification variables are documented here so far.)

# --- Email notifications (src/lib/notify) ---
# Resend API key used to send email.
RESEND_API_KEY=
# Sender. Resend only sends from a domain verified in the Resend dashboard (SPF/DKIM DNS records),
# so tulzo.online must be verified before this address works.
NOTIFY_FROM="Tulzo <notifications@tulzo.online>"
# HMAC secret for one-click unsubscribe links (at least 16 chars; e.g. `openssl rand -base64 32`).
# Rotating it breaks unsubscribe links in emails already sent.
NOTIFY_UNSUBSCRIBE_SECRET=
# Optional: schema holding the notification tables (default "public"; tests use a throwaway schema).
NOTIFY_DB_SCHEMA=
# Optional: address for the single manual live-send check. Tests never send real email.
TULZO_TEST_EMAIL=
# Shared with other crons: Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/notifications/dispatch.
CRON_SECRET=
# Root domain for links in emails (hub = root, others = <surface>.<root>; localhost uses /<surface> prefixes).
NEXT_PUBLIC_ROOT_DOMAIN=tulzo.online
