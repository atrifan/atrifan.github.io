# Environment variables for Tulzo. Copy to .env.local and fill in. Never commit real values.
# The rest of the app's variables (Clerk, Supabase STORAGE_*, AI_GATEWAY_API_KEY, ...) are documented in SETUP.md.


# --- Gigs: money -------------------------------------------------------------------
# Platform commission, added on top of the bid (a 300 EUR bid at 15% is charged 345 EUR).
# Percent, 0-100, at most two decimals. Default 15.
MARKETPLACE_COMMISSION_PERCENT=15
# Sanity bounds for a bid, in euro cents (inclusive). Defaults 500 (5 EUR) and 5000000 (50,000 EUR).
JOBS_MIN_BID_CENTS=500
JOBS_MAX_BID_CENTS=5000000

# --- Gigs: Stripe -----------------------------------------------------------------
# Existing: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET (use sk_test_/whsec_ test values locally).
# Signing secret of a separate Connect webhook endpoint, if account.updated is sent there.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Where Stripe sends a provider after Connect onboarding (return) or when the link expired
# (refresh). Defaults: <NEXT_PUBLIC_APP_URL>/profile?connect=return|refresh
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=

# --- Gigs: AI spec builder ---------------------------------------------------------
# AI Gateway model used to draft job specs (billed like /api/chat). Default openai/gpt-4o-mini.
JOBS_SPEC_MODEL=

# --- Tests only. Never set these in Vercel. -----------------------------------------
# Points the Stripe SDK at a local fake / stripe-mock (e.g. http://127.0.0.1:12111).
STRIPE_API_BASE=
# Enables the x-e2e-user / x-e2e-secret test identity on gigs routes, only when
# NODE_ENV != production. 16+ random characters.
JOBS_E2E_AUTH_SECRET=

# --- Email notifications (src/lib/notify) ---
# Resend API key used to send email.
RESEND_API_KEY=
# Sender. Resend only sends from a domain verified in the Resend dashboard (SPF/DKIM DNS records),
# so tulzo.online must be verified before this address works.
NOTIFY_FROM="Tulzo <notifications@tulzo.online>"
# HMAC secret for one-click unsubscribe links (at least 16 chars; e.g. `openssl rand -base64 32`).
# Rotating it breaks unsubscribe links in emails already sent.
NOTIFY_UNSUBSCRIBE_SECRET=
# Optional: schema holding the notification tables (default "public"; tests use a throwaway schema).
NOTIFY_DB_SCHEMA=
# Optional: address for the single manual live-send check. Tests never send real email.
TULZO_TEST_EMAIL=
# Shared with other crons: Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/notifications/dispatch.
CRON_SECRET=
# Root domain for links in emails (hub = root, others = <surface>.<root>; localhost uses /<surface> prefixes).
NEXT_PUBLIC_ROOT_DOMAIN=tulzo.online

# Which surface this deploy serves: hub | ai | marketplace | gigs | chat (src/lib/surface-routing.ts).
# Leave unset locally and on previews (every surface under /ai, /marketplace, /gigs, /chat). Surface mode
# needs NEXT_PUBLIC_ROOT_DOMAIN. Don't set it on the live `tulzo` project until the other projects exist.
TULZO_SURFACE=
# Clerk OAuth app used by the /api/oauth/* proxy. Required; the routes answer 500 server_misconfigured without them.
NEXT_PUBLIC_CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
