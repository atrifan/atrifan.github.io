{
  "name": "tulzo",
  "version": "1.0.0",
  "description": "Free tools for health, budget & daily life",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "build": "NODE_ENV=production next build",
    "start": "NODE_ENV=production next start",
    "lint": "next lint --dir app --dir src --dir tests --dir scripts --file middleware.ts --file playwright.config.ts --file vitest.config.ts --file vitest.int.config.ts",
    "type-check": "tsc --noEmit",
    "automation": "npx tsx scripts/run-workflow.ts",
    "publish:dmg": "npx tsx scripts/publish-dmg.ts",
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "test:ui": "playwright test --ui",
    "test:unit": "node --test 'tests/unit/**/*.test.ts' && vitest run",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:e2e:gigs": "tsx scripts/test-e2e-gigs.ts",
    "test:e2e:marketplace": "tsx scripts/test-e2e-marketplace.ts",
    "test:integration:notify": "playwright test tests/integration/notify.spec.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:visual": "playwright test tests/visual"
  },
  "dependencies": {
    "@adobe/react-spectrum": "^3.36.0",
    "@ai-sdk/mcp": "^1.0.13",
    "@ai-sdk/openai": "^3.0.7",
    "@clerk/nextjs": "^6.36.5",
    "@clerk/themes": "^2.4.46",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@supabase/supabase-js": "^2.78.0",
    "@types/leaflet": "^1.9.21",
    "@vercel/blob": "^1.1.1",
    "@vercel/functions": "^3.9.11",
    "ai": "^6.0.26",
    "chart.js": "^4.5.1",
    "dotenv": "^17.2.3",
    "graphql": "^16.12.0",
    "graphql-request": "^7.4.0",
    "katex": "^0.16.47",
    "leaflet": "^1.9.4",
    "mermaid": "^11.12.2",
    "next": "^14.2.21",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.1.1",
    "svix": "^1.84.1",
    "yaml": "^2.8.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@clerk/testing": "^2.2.45",
    "@playwright/test": "^1.49.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.17.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
