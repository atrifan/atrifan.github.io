{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/ai/automations/cron",
      "schedule": "0 10 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tulzo.online"
        }
      ],
      "destination": "https://www.tulzo.online/:path*",
      "permanent": true
    }
  ]
}

