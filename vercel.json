{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/auto-accept",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/trust-decay",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/credit-grants",
      "schedule": "15 0 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/api/:path*",
      "has": [
        {
          "type": "host",
          "value": "ai.tulzo.online"
        }
      ],
      "destination": "https://tulzo.online/api/:path*",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ai.tulzo.online"
        }
      ],
      "destination": "https://tulzo.online/ai",
      "permanent": false
    },
    {
      "source": "/:path*",
